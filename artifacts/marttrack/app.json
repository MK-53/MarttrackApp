{
  "expo": {
    "name": "MartTrack",
    "slug": "marttrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marttrack",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10110F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.marttrack.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "MartTrack connects to the store host on your shop's local Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.marttrack.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MartTrack to scan a store invitation QR code."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
